    "    kraus_map = DilutedChannel(kraus_map, kraus_chaos, p_5)\n",
    "    spectrum = channel_spectrum(kraus_map)\n",
    "    csr = complex_spacing_ratio(spectrum)\n",
    "    csr_list.append(csr)\n",
